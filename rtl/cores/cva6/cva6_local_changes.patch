@@ -34,6 +34,56 @@ module tc_sram_wrapper #(
   output data_t [NumPorts-1:0] rdata_o     // read data
 );
 
+`ifdef XILINX_FPGA
+
+  initial begin
+    if (NumPorts != 32'd1) begin
+      $fatal(1, "tc_sram_wrapper FPGA implementation supports NumPorts == 1 only (got %0d)", NumPorts);
+    end
+    if (DataWidth != 32'd64) begin
+      $fatal(1, "tc_sram_wrapper FPGA implementation supports DataWidth == 64 only (got %0d)", DataWidth);
+    end
+    if (ByteWidth != 32'd8) begin
+      $fatal(1, "tc_sram_wrapper FPGA implementation supports ByteWidth == 8 only (got %0d)", ByteWidth);
+    end
+  end
+
+  function automatic int unsigned sync_sram_init_sel(string mode);
+    if (mode == "zeros") begin
+      return 1;
+    end else if (mode == "random") begin
+      return 2;
