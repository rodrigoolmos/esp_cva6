+      return 3;
+    end else begin
+      if (!(mode == "none")) begin
+        $warning("SyncSpRamBeNx64 does not support SimInit=%s, defaulting to 'none'", mode);
+      end
+      return 0;
+    end
+  endfunction
+
+  localparam int unsigned SYNC_SRAM_SIM_INIT = sync_sram_init_sel(SimInit);
+  localparam int unsigned OUT_REGS = (Latency > 32'd1) ? 1 : 0;
+
+  SyncSpRamBeNx64 #(
+    .ADDR_WIDTH(AddrWidth),
+    .DATA_DEPTH(NumWords),
+    .OUT_REGS (OUT_REGS),
+    .SIM_INIT (SYNC_SRAM_SIM_INIT)
+  ) i_fpga_sram (
+    .Clk_CI    ( clk_i      ),
+    .Rst_RBI   ( rst_ni     ),
+    .CSel_SI   ( req_i[0]   ),
+    .WrEn_SI   ( we_i[0]    ),
+    .BEn_SI    ( be_i[0]    ),
+    .WrData_DI ( wdata_i[0] ),
+    .Addr_DI   ( addr_i[0]  ),
+    .RdData_DO ( rdata_o[0] )
+  );
+
+`else // !XILINX_FPGA
+
 // synthesis translate_off
 
   tc_sram #(
@@ -57,4 +107,6 @@ module tc_sram_wrapper #(
 
 // synthesis translate_on
 
+`endif // XILINX_FPGA
+
 endmodule
